{
    "name": "vis-stilling",
    "version": "0.1.0",
    "private": true,
    "homepage": "/arbeid/stilling",
    "packageManager": "pnpm@12.4.1",
    "dependencies": {
        "@nais/apm": "0.4.0",
        "@navikt/aksel-icons": "^8.16.2",
        "@navikt/ds-css": "^8.16.2",
        "@navikt/ds-react": "^8.16.2",
        "@navikt/nav-dekoratoren-moduler": "^4.5.0",
        "@navikt/next-logger": "^5.0.1",
        "@navikt/oasis": "^4.2.2",
        "@navikt/toi-next-frontend": "0.12.0",
        "date-fns": "^4.4.0",
        "next": "16.3.8",
        "pino": "^10.3.1",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@navikt/ds-tailwind": "^8.16.2",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^26.5.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "jsdom": "^30.0.1",
        "msw": "^2.15.0",
        "pino-pretty": "^13.1.3",
        "postcss": "^8.5.28",
        "prettier": "^3.9.6",
        "pretty-quick": "^4.2.2",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    },
    "scripts": {
        "dev": "next dev | pino-pretty --messageKey=message",
        "test": "playwright test",
        "test-dev": "NEXT_PUBLIC_PLAYWRIGHT_TEST_MODE=true next dev -p 1337",
        "test-build": "NEXT_PUBLIC_PLAYWRIGHT_TEST_MODE=true next build",
        "build": "next build",
        "start": "next start",
        "format": "prettier --write .",
        "test:a11y": "playwright test --grep @a11y --project='chromium*'"
    },
    "prettier": {
        "tabWidth": 4,
        "singleQuote": true,
        "trailingComma": "es5",
        "arrowParens": "always",
        "printWidth": 100
    },
    "eslintConfig": {
        "extends": "react-app"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
